# Optional. The app runs fully offline without any of these.
# Default answers are extractive (copied from retrieved passages with
# citations). If you later want a local model (for example Ollama) or
# any OpenAI-compatible endpoint to rewrite the answer from those same
# allowed passages, set the variables below. Unauthorized chunks are
# never sent to a model, even when this is on.
#
# Local Ollama example:
#   OPENAI_API_KEY=ollama
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=llama3
#
# OpenAI-compatible example:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini

# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Embedding backend. Default is "tfidf" (scikit-learn, no model download).
# Set to "sbert" only if you have installed sentence-transformers yourself.
# SECURE_RAG_EMBEDDINGS=tfidf
